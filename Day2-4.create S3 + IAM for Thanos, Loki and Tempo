thanos-045667250694-ap-south-1
loki-045667250694-ap-south-1
tempo-045667250694-ap-south-1


Create the three S3 buckets

$ aws s3api create-bucket \
  --bucket "$THANOS_BUCKET" \
  --region "$AWS_REGION" \
  --create-bucket-configuration LocationConstraint="$AWS_REGION"

$ aws s3api create-bucket \
  --bucket "$LOKI_BUCKET" \
  --region "$AWS_REGION" \
  --create-bucket-configuration LocationConstraint="$AWS_REGION"

$ aws s3api create-bucket \
  --bucket "$TEMPO_BUCKET" \
  --region "$AWS_REGION" \
  --create-bucket-configuration LocationConstraint="$AWS_REGION"

