sudo mkdir -p /opt/promtail
cd /opt/promtail
sudo wget -O /opt/promtail/promtail.zip \
https://github.com/grafana/loki/releases/download/v3.5.0/promtail-linux-amd64.zip
sudo unzip /opt/promtail/promtail.zip -d /opt/promtail
sudo mv /opt/promtail/promtail-linux-amd64 /opt/promtail/promtail
sudo chmod +x /opt/promtail/promtail
/opt/promtail/promtail --version


Create Promtail configuration
sudo mkdir -p /etc/promtail
sudo vi /etc/promtail/promtail.yaml
==================================

server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /var/lib/promtail/positions.yaml

clients:
  - url: http://10.0.2.20:3100/loki/api/v1/push

scrape_configs:
  - job_name: sample-app
    static_configs:
      - targets:
          - localhost
        labels:
          job: sample-app
          service: sample-flask-app
          environment: test
          host: application-ec2
          __path__: /var/log/sample-app/*.log


Create promtail service
sudo vi /etc/systemd/system/promtail.service
[Unit]
Description=Promtail Log Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=root
Group=root

ExecStart=/opt/promtail/promtail \
  -config.file=/etc/promtail/promtail.yaml

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target


sudo systemctl daemon-reload

