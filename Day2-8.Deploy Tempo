Install Tempo:
===========

helm repo add grafana-community https://grafana-community.github.io/helm-charts
helm repo update

helm search repo grafana-community/tempo

vi tempo-values.yaml
====================
tempo:
  reportingEnabled: false

  metricsGenerator:
    enabled: false

  storage:
    trace:
      backend: s3
      s3:
        bucket: tempo-045667250694-ap-south-1
        endpoint: s3.ap-south-1.amazonaws.com
        region: ap-south-1
        insecure: false

  retention: 168h

serviceAccount:
  create: false
  name: tempo-s3

persistence:
  enabled: true
  storageClassName: monitoring-gp3
  accessModes:
    - ReadWriteOnce
  size: 20Gi

tempoQuery:
  enabled: false

gateway:
  enabled: false

service:
  type: ClusterIP

traces:
  otlp:
    http:
      enabled: true
    grpc:
      enabled: true

resources:
  requests:
    cpu: 250m
    memory: 512Mi
  limits:
    cpu: "1"
    memory: 1Gi


tempo-s3
    ↓
TempoS3Role
    ↓
S3 bucket




helm upgrade --install tempo \
  grafana-community/tempo \
  --namespace monitoring \
  --values tempo-values.yaml


