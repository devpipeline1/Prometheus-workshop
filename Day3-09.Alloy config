                           │
                           │
                 ┌─────────▼──────────┐
                 │ kube-state-metrics │
                 │                    │
                 │ Kubernetes API     │
                 │ → Pod Metrics      │
                 │ → Deployment       │
                 │ → StatefulSet      │
                 │ → Node             │
                 │ → Namespace        │
                 └─────────┬──────────┘
                           │
                        /metrics
                           │
                           ▼
                    ┌─────────────┐
                    │    Alloy    │
                    │             │
                    │ Prometheus  │
                    │   Scrape    │
                    └──────┬──────┘
                           │
                      Remote Write
                           │
                           ▼
                    ┌─────────────┐
                    │    Mimir    │
                    └──────┬──────┘
                           │
