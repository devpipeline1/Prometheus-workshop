// ============================================================
// LOG DISCOVERY
// ============================================================

discovery.kubernetes "online_boutique_pods" {
  role = "pod"

  namespaces {
    names = ["online-boutique"]
  }
}


// ============================================================
// FILTER SELECTED MICROSERVICES
// ============================================================

discovery.relabel "online_boutique_logs" {

  targets = discovery.kubernetes.online_boutique_pods.targets


  // Keep only selected applications

  rule {
    action = "keep"

    source_labels = [
      "__meta_kubernetes_pod_label_app"
    ]

    regex = "frontend|emailservice|paymentservice|currencyservice|checkoutservice"
  }


  // Add namespace label

  rule {
    action = "replace"

    source_labels = [
      "__meta_kubernetes_namespace"
    ]

    target_label = "namespace"
  }


  // Add application label

  rule {
    action = "replace"

    source_labels = [
      "__meta_kubernetes_pod_label_app"
    ]

    target_label = "app"
  }


  // Add pod label

  rule {
    action = "replace"

    source_labels = [
      "__meta_kubernetes_pod_name"
    ]

    target_label = "pod"
  }

}


// ============================================================
// COLLECT FILTERED LOGS
// ============================================================

loki.source.kubernetes "online_boutique" {

  targets =
    discovery.relabel.online_boutique_logs.output

  forward_to = [
    loki.write.monitoring.receiver
  ]
}








