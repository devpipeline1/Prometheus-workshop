cat <<'EOF' > alloy-values.yaml
alloy:
  configMap:
    create: true
    content: |
      discovery.kubernetes "nodes" {
        role = "node"
      }

      discovery.relabel "node_metrics" {
        targets = discovery.kubernetes.nodes.targets

        rule {
          target_label = "__address__"
          replacement  = "kubernetes.default.svc:443"
        }

        rule {
          source_labels = ["__meta_kubernetes_node_name"]
          regex         = "(.+)"
          target_label  = "__metrics_path__"
          replacement   = "/api/v1/nodes/${1}/proxy/metrics"
        }
      }

      prometheus.scrape "nodes" {
        job_name        = "kubernetes-nodes"
        targets         = discovery.relabel.node_metrics.output
        forward_to      = [prometheus.remote_write.monitoring.receiver]
        scrape_interval = "30s"
        scrape_timeout  = "20s"
        scheme          = "https"

        tls_config {
          insecure_skip_verify = true
        }
      }

      discovery.kubernetes "pods" {
        role = "pod"
      }

      discovery.relabel "pod_metrics" {
        targets = discovery.kubernetes.pods.targets

        rule {
          source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_scrape"]
          action        = "keep"
          regex         = "true"
        }

        rule {
          source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_path"]
          action        = "replace"
          target_label  = "__metrics_path__"
          regex         = "(.+)"
        }

        rule {
          source_labels = [
            "__address__",
            "__meta_kubernetes_pod_annotation_prometheus_io_port",
          ]
          action        = "replace"
          regex         = "([^:]+)(?::[0-9]+)?;([0-9]+)"
          replacement   = "${1}:${2}"
          target_label  = "__address__"
        }
      }

      prometheus.scrape "pods" {
        job_name        = "kubernetes-pods"
        targets         = discovery.relabel.pod_metrics.output
        forward_to      = [prometheus.remote_write.monitoring.receiver]
        scrape_interval = "30s"
      }

      prometheus.remote_write "monitoring" {
        endpoint {
          url = "http://k8s-monitori-promethe-bc4a53910b-762e0685c2cb6419.elb.ap-south-1.amazonaws.com:9090/api/v1/write"
        }
      }

controller:
  type: daemonset

serviceAccount:
  create: true

rbac:
  create: true
EOF


