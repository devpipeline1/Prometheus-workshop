  --cluster $MON_CLUSTER \
  --region $AWS_REGION \
  --namespace kube-system \
  --name ebs-csi-controller-sa \
  --role-name AmazonEKS_EBS_CSI_DriverRole_monitoring \
  --role-only \
  --attach-policy-arn arn:aws:iam::aws:policy/service-role/AmazonEBSCSIDriverPolicy \
  --approve

Install or verify EBS CSI addon
-------------------------------
eksctl create addon \
  --cluster $MON_CLUSTER \
  --region $AWS_REGION \
  --name aws-ebs-csi-driver \
  --force

kubectl get pods -n kube-system | grep ebs

