Label-based log filtering
========================

discovery.kubernetes "online_boutique_pods" {

  role = "pod"

  namespaces {
    names = ["online-boutique"]
  }
}


discovery.relabel "logs_filter" {

  targets =
    discovery.kubernetes.online_boutique_pods.targets


  rule {

    action = "keep"

    source_labels = [
      "__meta_kubernetes_pod_label_observability_grafana_com_logs"
    ]

    regex = "true"
  }

}


loki.source.kubernetes "selected_logs" {

  targets =
    discovery.relabel.logs_filter.output

  forward_to = [
    loki.write.monitoring.receiver
  ]
}



