script

#!/bin/bash

set -e

# ============================================================
# AWS EKS WORKSHOP - PHASE 1 NETWORKING
# Creates:
#   Application VPC
#   Monitoring VPC
#   Public and Private Subnets
#   Internet Gateways
#   NAT Gateways
#   Route Tables
#   VPC Peering
# ============================================================

AWS_REGION="ap-south-1"

APP_VPC_CIDR="10.10.0.0/16"
MON_VPC_CIDR="10.20.0.0/16"

APP_PUBLIC_SUBNET_1="10.10.1.0/24"
APP_PUBLIC_SUBNET_2="10.10.2.0/24"
APP_PRIVATE_SUBNET_1="10.10.11.0/24"
APP_PRIVATE_SUBNET_2="10.10.12.0/24"

MON_PUBLIC_SUBNET_1="10.20.1.0/24"
MON_PUBLIC_SUBNET_2="10.20.2.0/24"
MON_PRIVATE_SUBNET_1="10.20.11.0/24"
MON_PRIVATE_SUBNET_2="10.20.12.0/24"

AZ1="${AWS_REGION}a"
AZ2="${AWS_REGION}b"

echo "============================================================"
echo "AWS REGION: $AWS_REGION"
echo "============================================================"

# ============================================================
# CREATE APPLICATION VPC
# ============================================================

echo "Creating Application VPC..."

APP_VPC_ID=$(aws ec2 create-vpc \
  --region "$AWS_REGION" \
  --cidr-block "$APP_VPC_CIDR" \
  --query 'Vpc.VpcId' \
  --output text)

aws ec2 create-tags \
  --region "$AWS_REGION" \
  --resources "$APP_VPC_ID" \
  --tags Key=Name,Value=application-vpc

aws ec2 modify-vpc-attribute \
  --region "$AWS_REGION" \
  --vpc-id "$APP_VPC_ID" \
  --enable-dns-support "{\"Value\":true}"

aws ec2 modify-vpc-attribute \
  --region "$AWS_REGION" \
  --vpc-id "$APP_VPC_ID" \
  --enable-dns-hostnames "{\"Value\":true}"

echo "Application VPC: $APP_VPC_ID"


# ============================================================
# CREATE MONITORING VPC
# ============================================================

echo "Creating Monitoring VPC..."

MON_VPC_ID=$(aws ec2 create-vpc \
  --region "$AWS_REGION" \
  --cidr-block "$MON_VPC_CIDR" \
  --query 'Vpc.VpcId' \
  --output text)

aws ec2 create-tags \
  --region "$AWS_REGION" \
  --resources "$MON_VPC_ID" \
  --tags Key=Name,Value=monitoring-vpc

aws ec2 modify-vpc-attribute \
  --region "$AWS_REGION" \
  --vpc-id "$MON_VPC_ID" \
  --enable-dns-support "{\"Value\":true}"

aws ec2 modify-vpc-attribute \
  --region "$AWS_REGION" \
  --vpc-id "$MON_VPC_ID" \
  --enable-dns-hostnames "{\"Value\":true}"

echo "Monitoring VPC: $MON_VPC_ID"


# ============================================================
# APPLICATION SUBNETS
# ============================================================

echo "Creating Application subnets..."

APP_PUBLIC_SUBNET_ID_1=$(aws ec2 create-subnet \
  --region "$AWS_REGION" \
  --vpc-id "$APP_VPC_ID" \
  --cidr-block "$APP_PUBLIC_SUBNET_1" \
  --availability-zone "$AZ1" \
  --query 'Subnet.SubnetId' \
  --output text)

APP_PUBLIC_SUBNET_ID_2=$(aws ec2 create-subnet \
  --region "$AWS_REGION" \
  --vpc-id "$APP_VPC_ID" \
  --cidr-block "$APP_PUBLIC_SUBNET_2" \
  --availability-zone "$AZ2" \
  --query 'Subnet.SubnetId' \
  --output text)

APP_PRIVATE_SUBNET_ID_1=$(aws ec2 create-subnet \
  --region "$AWS_REGION" \
  --vpc-id "$APP_VPC_ID" \
  --cidr-block "$APP_PRIVATE_SUBNET_1" \
  --availability-zone "$AZ1" \
  --query 'Subnet.SubnetId' \
  --output text)

APP_PRIVATE_SUBNET_ID_2=$(aws ec2 create-subnet \
  --region "$AWS_REGION" \
  --vpc-id "$APP_VPC_ID" \
  --cidr-block "$APP_PRIVATE_SUBNET_2" \
  --availability-zone "$AZ2" \
  --query 'Subnet.SubnetId' \
  --output text)


# ============================================================
# MONITORING SUBNETS
# ============================================================

echo "Creating Monitoring subnets..."

MON_PUBLIC_SUBNET_ID_1=$(aws ec2 create-subnet \
  --region "$AWS_REGION" \
  --vpc-id "$MON_VPC_ID" \
  --cidr-block "$MON_PUBLIC_SUBNET_1" \
  --availability-zone "$AZ1" \
  --query 'Subnet.SubnetId' \
  --output text)

MON_PUBLIC_SUBNET_ID_2=$(aws ec2 create-subnet \
  --region "$AWS_REGION" \
  --vpc-id "$MON_VPC_ID" \
  --cidr-block "$MON_PUBLIC_SUBNET_2" \
  --availability-zone "$AZ2" \
  --query 'Subnet.SubnetId' \
  --output text)

MON_PRIVATE_SUBNET_ID_1=$(aws ec2 create-subnet \
  --region "$AWS_REGION" \
  --vpc-id "$MON_VPC_ID" \
  --cidr-block "$MON_PRIVATE_SUBNET_1" \
  --availability-zone "$AZ1" \
  --query 'Subnet.SubnetId' \
  --output text)

MON_PRIVATE_SUBNET_ID_2=$(aws ec2 create-subnet \
  --region "$AWS_REGION" \
  --vpc-id "$MON_VPC_ID" \
  --cidr-block "$MON_PRIVATE_SUBNET_2" \
  --availability-zone "$AZ2" \
  --query 'Subnet.SubnetId' \
  --output text)


# ============================================================
# TAG SUBNETS
# ============================================================

echo "Tagging subnets..."

aws ec2 create-tags --region "$AWS_REGION" \
  --resources "$APP_PUBLIC_SUBNET_ID_1" \
  --tags Key=Name,Value=application-public-1

aws ec2 create-tags --region "$AWS_REGION" \
  --resources "$APP_PUBLIC_SUBNET_ID_2" \
  --tags Key=Name,Value=application-public-2

aws ec2 create-tags --region "$AWS_REGION" \
  --resources "$APP_PRIVATE_SUBNET_ID_1" \
  --tags Key=Name,Value=application-private-1

aws ec2 create-tags --region "$AWS_REGION" \
  --resources "$APP_PRIVATE_SUBNET_ID_2" \
  --tags Key=Name,Value=application-private-2

aws ec2 create-tags --region "$AWS_REGION" \
  --resources "$MON_PUBLIC_SUBNET_ID_1" \
  --tags Key=Name,Value=monitoring-public-1

aws ec2 create-tags --region "$AWS_REGION" \
  --resources "$MON_PUBLIC_SUBNET_ID_2" \
  --tags Key=Name,Value=monitoring-public-2

aws ec2 create-tags --region "$AWS_REGION" \
  --resources "$MON_PRIVATE_SUBNET_ID_1" \
  --tags Key=Name,Value=monitoring-private-1

aws ec2 create-tags --region "$AWS_REGION" \
  --resources "$MON_PRIVATE_SUBNET_ID_2" \
  --tags Key=Name,Value=monitoring-private-2


# ============================================================
# INTERNET GATEWAYS
# ============================================================

echo "Creating Internet Gateways..."

APP_IGW_ID=$(aws ec2 create-internet-gateway \
  --region "$AWS_REGION" \
  --query 'InternetGateway.InternetGatewayId' \
  --output text)

aws ec2 attach-internet-gateway \
  --region "$AWS_REGION" \
  --internet-gateway-id "$APP_IGW_ID" \
  --vpc-id "$APP_VPC_ID"

MON_IGW_ID=$(aws ec2 create-internet-gateway \
  --region "$AWS_REGION" \
  --query 'InternetGateway.InternetGatewayId' \
  --output text)

aws ec2 attach-internet-gateway \
  --region "$AWS_REGION" \
  --internet-gateway-id "$MON_IGW_ID" \
  --vpc-id "$MON_VPC_ID"


# ============================================================
# PUBLIC ROUTE TABLES
# ============================================================

echo "Creating Public Route Tables..."

APP_PUBLIC_RT=$(aws ec2 create-route-table \
  --region "$AWS_REGION" \
  --vpc-id "$APP_VPC_ID" \
  --query 'RouteTable.RouteTableId' \
  --output text)

aws ec2 create-route \
  --region "$AWS_REGION" \
  --route-table-id "$APP_PUBLIC_RT" \
  --destination-cidr-block 0.0.0.0/0 \
  --gateway-id "$APP_IGW_ID"

aws ec2 associate-route-table \
  --region "$AWS_REGION" \
  --route-table-id "$APP_PUBLIC_RT" \
  --subnet-id "$APP_PUBLIC_SUBNET_ID_1"

aws ec2 associate-route-table \
  --region "$AWS_REGION" \
  --route-table-id "$APP_PUBLIC_RT" \
  --subnet-id "$APP_PUBLIC_SUBNET_ID_2"


MON_PUBLIC_RT=$(aws ec2 create-route-table \
  --region "$AWS_REGION" \
  --vpc-id "$MON_VPC_ID" \
  --query 'RouteTable.RouteTableId' \
  --output text)

aws ec2 create-route \
  --region "$AWS_REGION" \
  --route-table-id "$MON_PUBLIC_RT" \
  --destination-cidr-block 0.0.0.0/0 \
  --gateway-id "$MON_IGW_ID"

aws ec2 associate-route-table \
  --region "$AWS_REGION" \
  --route-table-id "$MON_PUBLIC_RT" \
  --subnet-id "$MON_PUBLIC_SUBNET_ID_1"

aws ec2 associate-route-table \
  --region "$AWS_REGION" \
  --route-table-id "$MON_PUBLIC_RT" \
  --subnet-id "$MON_PUBLIC_SUBNET_ID_2"


# ============================================================
# NAT GATEWAYS
# ============================================================

echo "Creating Elastic IPs..."

APP_NAT_EIP=$(aws ec2 allocate-address \
  --region "$AWS_REGION" \
  --domain vpc \
  --query 'AllocationId' \
  --output text)

MON_NAT_EIP=$(aws ec2 allocate-address \
  --region "$AWS_REGION" \
  --domain vpc \
  --query 'AllocationId' \
  --output text)


echo "Creating NAT Gateways..."

APP_NAT_ID=$(aws ec2 create-nat-gateway \
  --region "$AWS_REGION" \
  --subnet-id "$APP_PUBLIC_SUBNET_ID_1" \
  --allocation-id "$APP_NAT_EIP" \
  --query 'NatGateway.NatGatewayId' \
  --output text)

MON_NAT_ID=$(aws ec2 create-nat-gateway \
  --region "$AWS_REGION" \
  --subnet-id "$MON_PUBLIC_SUBNET_ID_1" \
  --allocation-id "$MON_NAT_EIP" \
  --query 'NatGateway.NatGatewayId' \
  --output text)


echo "Waiting for NAT Gateways..."

aws ec2 wait nat-gateway-available \
  --region "$AWS_REGION" \
  --nat-gateway-ids "$APP_NAT_ID"

aws ec2 wait nat-gateway-available \
  --region "$AWS_REGION" \
  --nat-gateway-ids "$MON_NAT_ID"


# ============================================================
# PRIVATE ROUTE TABLES
# ============================================================

echo "Creating Private Route Tables..."

APP_PRIVATE_RT=$(aws ec2 create-route-table \
  --region "$AWS_REGION" \
  --vpc-id "$APP_VPC_ID" \
  --query 'RouteTable.RouteTableId' \
  --output text)

aws ec2 create-route \
  --region "$AWS_REGION" \
  --route-table-id "$APP_PRIVATE_RT" \
  --destination-cidr-block 0.0.0.0/0 \
  --nat-gateway-id "$APP_NAT_ID"

aws ec2 associate-route-table \
  --region "$AWS_REGION" \
  --route-table-id "$APP_PRIVATE_RT" \
  --subnet-id "$APP_PRIVATE_SUBNET_ID_1"

aws ec2 associate-route-table \
  --region "$AWS_REGION" \
  --route-table-id "$APP_PRIVATE_RT" \
  --subnet-id "$APP_PRIVATE_SUBNET_ID_2"


MON_PRIVATE_RT=$(aws ec2 create-route-table \
  --region "$AWS_REGION" \
  --vpc-id "$MON_VPC_ID" \
  --query 'RouteTable.RouteTableId' \
  --output text)

aws ec2 create-route \
  --region "$AWS_REGION" \
  --route-table-id "$MON_PRIVATE_RT" \
  --destination-cidr-block 0.0.0.0/0 \
  --nat-gateway-id "$MON_NAT_ID"

aws ec2 associate-route-table \
  --region "$AWS_REGION" \
  --route-table-id "$MON_PRIVATE_RT" \
  --subnet-id "$MON_PRIVATE_SUBNET_ID_1"

aws ec2 associate-route-table \
  --region "$AWS_REGION" \
  --route-table-id "$MON_PRIVATE_RT" \
  --subnet-id "$MON_PRIVATE_SUBNET_ID_2"


# ============================================================
# VPC PEERING
# ============================================================

echo "Creating VPC Peering..."

PEERING_ID=$(aws ec2 create-vpc-peering-connection \
  --region "$AWS_REGION" \
  --vpc-id "$APP_VPC_ID" \
  --peer-vpc-id "$MON_VPC_ID" \
  --peer-region "$AWS_REGION" \
  --query 'VpcPeeringConnection.VpcPeeringConnectionId' \
  --output text)

aws ec2 accept-vpc-peering-connection \
  --region "$AWS_REGION" \
  --vpc-peering-connection-id "$PEERING_ID"


# ============================================================
# VPC PEERING ROUTES
# ============================================================

echo "Creating VPC Peering Routes..."

aws ec2 create-route \
  --region "$AWS_REGION" \
  --route-table-id "$APP_PRIVATE_RT" \
  --destination-cidr-block "$MON_VPC_CIDR" \
  --vpc-peering-connection-id "$PEERING_ID"

aws ec2 create-route \
  --region "$AWS_REGION" \
  --route-table-id "$MON_PRIVATE_RT" \
  --destination-cidr-block "$APP_VPC_CIDR" \
  --vpc-peering-connection-id "$PEERING_ID"


# ============================================================
# SAVE OUTPUT
# ============================================================

cat > network-info.env <<EOF2
export AWS_REGION=$AWS_REGION

export APP_VPC_ID=$APP_VPC_ID
export MON_VPC_ID=$MON_VPC_ID

export APP_PUBLIC_SUBNET_1=$APP_PUBLIC_SUBNET_ID_1
export APP_PUBLIC_SUBNET_2=$APP_PUBLIC_SUBNET_ID_2

export APP_PRIVATE_SUBNET_1=$APP_PRIVATE_SUBNET_ID_1
export APP_PRIVATE_SUBNET_2=$APP_PRIVATE_SUBNET_ID_2

export MON_PUBLIC_SUBNET_1=$MON_PUBLIC_SUBNET_ID_1
export MON_PUBLIC_SUBNET_2=$MON_PUBLIC_SUBNET_ID_2

export MON_PRIVATE_SUBNET_1=$MON_PRIVATE_SUBNET_ID_1
export MON_PRIVATE_SUBNET_2=$MON_PRIVATE_SUBNET_ID_2

export APP_NAT_ID=$APP_NAT_ID
export MON_NAT_ID=$MON_NAT_ID

export PEERING_ID=$PEERING_ID
EOF2


echo ""
echo "============================================================"
echo "PHASE 1 NETWORKING COMPLETED"
echo "============================================================"

cat network-info.env



