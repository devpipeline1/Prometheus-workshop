Metric control:
================

kubectl annotate deployment frontend \
  -n online-boutique \
  prometheus.io/scrape=true


kubectl annotate deployment frontend \
  -n online-boutique \
  prometheus.io/path=/metrics


kubectl annotate deployment frontend \
  -n online-boutique \
  prometheus.io/port=8080


filter only pods where: prometheus.io/scrape=true



discovery.relabel "metrics_filter" {

  targets =
    discovery.kubernetes.metrics_pods.targets


  rule {

    action = "keep"

    source_labels = [
      "__meta_kubernetes_pod_annotation_prometheus_io_scrape"
    ]

    regex = "true"
  }


  rule {

    action = "replace"

    source_labels = [
      "__meta_kubernetes_pod_annotation_prometheus_io_path"
    ]

    target_label = "__metrics_path__"

    regex = "(.+)"
  }


  rule {

    action = "replace"

    source_labels = [
      "__meta_kubernetes_pod_annotation_prometheus_io_port"
    ]

    target_label = "__address__"

    replacement = "$1"

  }

}



Then scrape:

prometheus.scrape "selected_microservices" {

  targets =
    discovery.relabel.metrics_filter.output

  forward_to = [
    prometheus.remote_write.monitoring.receiver
  ]

}

Then write:
prometheus.remote_write "monitoring" {

  endpoint {

    url = "http://PROMETHEUS-NLB:9090/api/v1/write"

  }

  external_labels = {

    cluster     = "application-eks"
    environment = "demo"

  }

}


