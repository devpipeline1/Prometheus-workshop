Create the Thanos S3 object-store configuration:
===============================================
export AWS_REGION=ap-south-1
export AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
export THANOS_BUCKET="thanos-${AWS_ACCOUNT_ID}-${AWS_REGION}"

echo "$THANOS_BUCKET"

Expected:
thanos-045667250694-ap-south-1

Create thanos-objstore.yaml (This object store config we are going to use secret for thanos sidecare)
==========================
cat > thanos-objstore.yaml <<EOF
type: S3
config:
  bucket: ${THANOS_BUCKET}
  endpoint: s3.${AWS_REGION}.amazonaws.com
  region: ${AWS_REGION}
  aws_sdk_auth: true
  insecure: false
EOF

$ cat thanos-objstore.yaml
type: S3
config:
  bucket: thanos-045667250694-ap-south-1
  endpoint: s3.ap-south-1.amazonaws.com
  region: ap-south-1
  aws_sdk_auth: true
  insecure: false

Create the Kubernetes Secret:
=============================
$ kubectl create secret generic thanos-objstore-config \
  -n monitoring \
  --from-file=objstore.yml=thanos-objstore.yaml \
  --dry-run=client \
  -o yaml | kubectl apply -f -

kubectl get secret thanos-objstore-config -n monitoring

$ kubectl get secret thanos-objstore-config \
  -n monitoring \
