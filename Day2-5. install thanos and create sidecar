deploy Thanos Store Gateway + Compactor + Query by installing Thanos
====================================================================
vi thanos-values.yaml

global:
  security:
    allowInsecureImages: true

image:
  registry: quay.io
  repository: thanos/thanos
  tag: v0.42.4
  pullPolicy: IfNotPresent

existingObjstoreSecret: thanos-objstore-config

existingObjstoreSecretItems:
  - key: objstore.yml
    path: objstore.yml

query:
  enabled: true

  replicaLabel:
    - prometheus_replica

  dnsDiscovery:
    enabled: false

  stores:
    - kube-prometheus-stack-thanos-discovery.monitoring.svc.cluster.local:10901

  service:
    type: ClusterIP

storegateway:
  enabled: true

  serviceAccount:
    create: false
    name: thanos-s3

  persistence:
    enabled: true
    storageClass: monitoring-gp3
    accessModes:
      - ReadWriteOnce
    size: 20Gi

compactor:
  enabled: true

  serviceAccount:
    create: false
    name: thanos-s3

  persistence:
    enabled: true
    storageClass: monitoring-gp3
    accessModes:
      - ReadWriteOnce
    size: 20Gi

bucketweb:
  enabled: true

  service:
    type: ClusterIP

Install Thanos:
helm repo add bitnami https://charts.bitnami.com/bitnami
helm repo update

helm upgrade --install thanos \
  bitnami/thanos \
  --namespace monitoring \
  --values thanos-values.yaml


