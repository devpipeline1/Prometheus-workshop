Create namespace:
=================
kubectl create namespace otel-application

vi otel-demo-values.yaml
========================
# ============================================================
# OpenTelemetry Demo
# application-eks
#
# Architecture:
#
# OpenTelemetry Demo
#        |
#        v
# Demo OTEL Collector
#        |
#        | OTLP gRPC
#        v
#      Alloy
#   |      |      |
#   v      v      v
# Mimir   Loki   Tempo
#
# ============================================================


# ============================================================
# FRONTEND PROXY
# ============================================================

components:
  frontend-proxy:
    service:
      type: LoadBalancer

      annotations:
        service.beta.kubernetes.io/aws-load-balancer-type: "external"
        service.beta.kubernetes.io/aws-load-balancer-nlb-target-type: "ip"
        service.beta.kubernetes.io/aws-load-balancer-scheme: "internet-facing"


# ============================================================
# DISABLE OBSERVABILITY BACKENDS BUNDLED WITH THE DEMO
# ============================================================
#
# We already have:
#
#   Grafana
#   Mimir
#   Loki
#   Tempo
#
# in monitoring-eks.
#
# Therefore we don't need duplicate backends in application-eks.
# ============================================================

jaeger:
  enabled: false

prometheus:
  enabled: false

grafana:
  enabled: false

opensearch:
  enabled: false


# ============================================================
# OPENTELEMETRY COLLECTOR
# ============================================================

opentelemetry-collector:

  config:

    exporters:

      # --------------------------------------------------------
      # Send telemetry to Alloy
      #
      # Alloy service:
      #   alloy
      #
      # Namespace:
      #   alloy
      #
      # OTLP gRPC:
      #   4317
      # --------------------------------------------------------

      otlp/alloy:
        endpoint: alloy.alloy.svc.cluster.local:4317

        tls:
          insecure: true

      # What should happen to each telemetry signal
    service:
      pipelines:
        # ------------------------------------------------------
        # TRACES
        # ------------------------------------------------------

        traces:
          exporters:
            - span_metrics
            - otlp/alloy
        # ------------------------------------------------------
        # METRICS
        # ------------------------------------------------------

        metrics:
          exporters:
            - otlp/alloy
        # ------------------------------------------------------
        # LOGS
        # ------------------------------------------------------

        logs:
          exporters:
            - otlp/alloy



