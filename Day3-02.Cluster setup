$ vi application-eks.yaml
apiVersion: eksctl.io/v1alpha5
kind: ClusterConfig

metadata:
  name: application-eks
  region: ap-south-1
  version: "1.36"

vpc:
  id: vpc-09cfb9e646bccec67
  subnets:
    private:
      ap-south-1a:
        id: subnet-0132d5604a53a5fa5

      ap-south-1b:
        id: subnet-036ebc6c7fda913c9

  clusterEndpoints:
    publicAccess: true
    privateAccess: true

iam:
  withOIDC: true

managedNodeGroups:
  - name: application-workers
    instanceType: t3.large
    desiredCapacity: 1
    minSize: 1
    maxSize: 3
    privateNetworking: true
    volumeSize: 50
    labels:
      workload: application
    tags:
      Environment: demo
      Cluster: application-eks
      Purpose: easytrade
addons:
  - name: vpc-cni
    resolveConflicts: overwrite
  - name: coredns
    resolveConflicts: overwrite
  - name: kube-proxy
    resolveConflicts: overwrite
  - name: aws-ebs-csi-driver
    resolveConflicts: overwrite


eksctl create cluster \
  -f application-eks.yaml \
  --dry-run


Rename contest so it will be easy to switch clusters
kubectl config rename-context \
  $(kubectl config get-contexts -o name | grep 'application-eks') \
  application-eks

kubectl config rename-context \
  $(kubectl config get-contexts -o name | grep 'monitoring-eks') \
  monitoring-eks


Verify the EBS CSI driver:
kubectl get pods -n kube-system \
  -l app.kubernetes.io/name=aws-ebs-csi-driver

Create storage class on both the clusters:
=========================================

kubectl config use-context application-eks

vi application-gp3.yaml
-----------------------
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: application-gp3
provisioner: ebs.csi.aws.com
parameters:
  type: gp3
  fsType: ext4
volumeBindingMode: WaitForFirstConsumer
allowVolumeExpansion: true
reclaimPolicy: Delete

kubectl apply -f application-gp3.yaml

kubectl config use-context monitoring-eks

vi monitoring-gp3.yaml
-----------------------
