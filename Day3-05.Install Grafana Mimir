Add Grafana Helm Repository:
===========================
helm repo add grafana https://grafana.github.io/helm-charts
helm repo update
helm search repo grafana/mimir-distributed

Create AWS S3 Bucket:
====================
aws s3api create-bucket \
  --bucket "$MIMIR_BUCKET" \
  --region "$AWS_REGION" \
  --create-bucket-configuration \
  LocationConstraint="$AWS_REGION"

Verify:
======
aws s3api head-bucket \
  --bucket "$MIMIR_BUCKET"

  aws s3 ls | grep "$MIMIR_BUCKET"

Enable Bucket Versioning:
========================
aws s3api put-bucket-versioning \
  --bucket "$MIMIR_BUCKET" \
  --versioning-configuration Status=Enabled

Verify:
======
aws s3api get-bucket-versioning \
  --bucket "$MIMIR_BUCKET"
  
Create IAM Policy for Mimir:
===========================
vi mimir-s3-policy.json

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::MIMIR_BUCKET_NAME"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::MIMIR_BUCKET_NAME/*"
      ]
    }
  ]
}

Replace bucket name and verify:
==============================
sed -i "s/MIMIR_BUCKET_NAME/$MIMIR_BUCKET/g"   mimir-s3-policy.json

cat mimir-s3-policy.json

Create Mimir IAM Policy:
=======================
export MIMIR_POLICY_NAME=MimirS3AccessPolicy

aws iam create-policy \
  --policy-name "$MIMIR_POLICY_NAME" \
  --policy-document \
file://mimir-s3-policy.json

export MIMIR_POLICY_ARN=arn:aws:iam::$ACCOUNT_ID:policy/$MIMIR_POLICY_NAME

