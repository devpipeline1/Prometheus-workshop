Review remaining NAT Gateways and LoadBalancers and public elastic IP's and remove manually.
They can continue generating AWS charges.



vi cleanupawsinfra.sh

$ cat cleanup.sh
#!/bin/bash

set +e

# ============================================================
# CONFIGURATION
# ============================================================

export AWS_REGION=ap-south-1

export MON_CLUSTER=monitoring3-eks
export APP_CLUSTER=application-eks

export MON_VPC_ID=vpc-04ee5884d92422db8
export APP_VPC_ID=vpc-073622fabdeda02e5

export ACCOUNT_ID=$(aws sts get-caller-identity \
  --query Account \
  --output text)

echo "============================================================"
echo " AWS COMPLETE LAB CLEANUP"
echo " Region: $AWS_REGION"
echo " Account: $ACCOUNT_ID"
echo "============================================================"

# ============================================================
# 1. DELETE KUBERNETES LOADBALANCER SERVICES
# ============================================================

echo ""
echo "STEP 1: Deleting Kubernetes LoadBalancer services..."

for CLUSTER in $MON_CLUSTER $APP_CLUSTER
do
  echo "Updating kubeconfig for $CLUSTER..."

  aws eks update-kubeconfig \
    --region $AWS_REGION \
    --name $CLUSTER 2>/dev/null

  kubectl get svc \
    -A \
    --field-selector spec.type=LoadBalancer \
    -o jsonpath='{range .items[*]}{.metadata.namespace}{" "}{.metadata.name}{"\n"}{end}' \
    2>/dev/null |
  while read NS NAME
  do
    if [ -n "$NAME" ]; then
      echo "Deleting LoadBalancer service: $NS/$NAME"
      kubectl delete svc "$NAME" \
        -n "$NS" \
        --ignore-not-found
    fi
  done

done

echo "Waiting for Load Balancers to disappear..."
sleep 60


# ============================================================
# 2. DELETE EKS CLUSTERS USING EKSCTL
# ============================================================

echo ""
echo "STEP 2: Deleting EKS clusters..."

echo "Deleting monitoring cluster..."

eksctl delete cluster \
  --name $MON_CLUSTER \
  --region $AWS_REGION \
  --wait=false

echo "Deleting application cluster..."

eksctl delete cluster \
  --name $APP_CLUSTER \
  --region $AWS_REGION \
  --wait=false


# ============================================================
# 3. WAIT FOR EKS CLUSTERS
# ============================================================

echo ""
echo "STEP 3: Waiting for EKS clusters to delete..."

for CLUSTER in $MON_CLUSTER $APP_CLUSTER
do
  echo "Waiting for cluster $CLUSTER..."

  while true
  do
    STATUS=$(aws eks describe-cluster \
      --name $CLUSTER \
      --region $AWS_REGION \
      --query 'cluster.status' \
      --output text 2>/dev/null)

    if [ "$STATUS" == "None" ] || [ -z "$STATUS" ]; then
      echo "$CLUSTER deleted."
      break
    fi

    echo "$CLUSTER status: $STATUS"
    sleep 30
  done

done


# ============================================================
# 4. DELETE CLOUDFORMATION STACKS
# ============================================================

echo ""
echo "STEP 4: Deleting remaining eksctl CloudFormation stacks..."

STACKS=$(aws cloudformation list-stacks \
  --region $AWS_REGION \
  --query "StackSummaries[?contains(StackName,'eksctl') && StackStatus!='DELETE_COMPLETE'].StackName" \
  --output text)

for STACK in $STACKS
do
  echo "Checking termination protection for $STACK..."

  aws cloudformation update-termination-protection \
    --stack-name "$STACK" \
    --no-enable-termination-protection \
    --region $AWS_REGION 2>/dev/null

  echo "Deleting stack: $STACK"

  aws cloudformation delete-stack \
    --stack-name "$STACK" \
    --region $AWS_REGION
done


# ============================================================
# 5. WAIT FOR CLOUDFORMATION STACKS
# ============================================================

echo ""
echo "STEP 5: Waiting for CloudFormation stacks..."

for STACK in $STACKS
do
  echo "Waiting for $STACK..."

  aws cloudformation wait stack-delete-complete \
    --stack-name "$STACK" \
    --region $AWS_REGION 2>/dev/null

done


# ============================================================
# 6. DELETE VPC PEERING CONNECTIONS
# ============================================================

echo ""
echo "STEP 6: Deleting VPC Peering connections..."

PEERINGS=$(aws ec2 describe-vpc-peering-connections \
  --region $AWS_REGION \
  --query "VpcPeeringConnections[?Status.Code=='active' || Status.Code=='pending-acceptance'].VpcPeeringConnectionId" \
  --output text)

for PCX in $PEERINGS
do
  echo "Deleting VPC Peering: $PCX"

  aws ec2 delete-vpc-peering-connection \
    --vpc-peering-connection-id "$PCX" \
    --region $AWS_REGION
done


# ============================================================
# 7. DELETE NAT GATEWAYS
# ============================================================

echo ""
echo "STEP 7: Checking NAT Gateways..."

for VPC in $MON_VPC_ID $APP_VPC_ID
do

  NAT_GATEWAYS=$(aws ec2 describe-nat-gateways \
    --region $AWS_REGION \
    --filter "Name=vpc-id,Values=$VPC" \
    --query "NatGateways[?State!='deleted'].NatGatewayId" \
    --output text)

  for NAT in $NAT_GATEWAYS
  do
    echo "Deleting NAT Gateway: $NAT"

    aws ec2 delete-nat-gateway \
      --nat-gateway-id "$NAT" \
      --region $AWS_REGION
  done

done


# ============================================================
# 8. WAIT FOR NAT GATEWAYS
# ============================================================

echo ""
echo "STEP 8: Waiting for NAT Gateways deletion..."

sleep 60


# ============================================================
# 9. RELEASE ELASTIC IPs
# ============================================================

echo ""
echo "STEP 9: Releasing Elastic IPs related to this lab..."

for VPC in $MON_VPC_ID $APP_VPC_ID
do

  EIPS=$(aws ec2 describe-addresses \
    --region $AWS_REGION \
    --query "Addresses[?contains(join(' ',Tags[].Value),'eksctl')].AllocationId" \
    --output text)

  for EIP in $EIPS
  do
    echo "Releasing Elastic IP: $EIP"

    aws ec2 release-address \
      --allocation-id "$EIP" \
      --region $AWS_REGION
  done

done


# ============================================================
# 10. DELETE REMAINING LOAD BALANCERS
# ============================================================

echo ""
echo "STEP 10: Checking Load Balancers..."

LOAD_BALANCERS=$(aws elbv2 describe-load-balancers \
  --region $AWS_REGION \
  --query "LoadBalancers[].LoadBalancerArn" \
  --output text 2>/dev/null)

for LB in $LOAD_BALANCERS
do
  echo "Deleting Load Balancer: $LB"

  aws elbv2 delete-load-balancer \
    --load-balancer-arn "$LB" \
    --region $AWS_REGION
done


# ============================================================
# 11. DELETE S3 THANOS BUCKET
# ============================================================

echo ""
echo "STEP 11: Deleting Thanos S3 bucket..."

export THANOS_BUCKET="thanos-metrics-${ACCOUNT_ID}-${AWS_REGION}"

BUCKET_EXISTS=$(aws s3api head-bucket \
  --bucket "$THANOS_BUCKET" \
  --region $AWS_REGION 2>/dev/null && echo "yes")

if [ "$BUCKET_EXISTS" == "yes" ]; then

  echo "Deleting all objects and versions from $THANOS_BUCKET..."

  aws s3api list-object-versions \
    --bucket "$THANOS_BUCKET" \
    --region $AWS_REGION \
    --output json \
  | python -c '
import sys,json
data=json.load(sys.stdin)
objects=[]
for x in data.get("Versions",[]):
    objects.append({"Key":x["Key"],"VersionId":x["VersionId"]})
for x in data.get("DeleteMarkers",[]):
    objects.append({"Key":x["Key"],"VersionId":x["VersionId"]})
print(json.dumps({"Objects":objects,"Quiet":True}))
' > delete-versions.json

  if [ -s delete-versions.json ]; then
    aws s3api delete-objects \
      --bucket "$THANOS_BUCKET" \
      --region $AWS_REGION \
      --delete file://delete-versions.json
  fi

  rm -f delete-versions.json

  aws s3 rb \
    "s3://$THANOS_BUCKET" \
    --force \
    --region $AWS_REGION

fi


# ============================================================
# 12. DELETE IAM ROLES
# ============================================================

echo ""
echo "STEP 12: Checking IAM roles..."

ROLES=$(aws iam list-roles \
  --query "Roles[?contains(RoleName,'Thanos') || contains(RoleName,'AmazonEKSLoadBalancerController')].RoleName" \
  --output text)

for ROLE in $ROLES
do
  echo "Removing policies from role: $ROLE"

  POLICIES=$(aws iam list-attached-role-policies \
    --role-name "$ROLE" \
    --query 'AttachedPolicies[].PolicyArn' \
    --output text)

  for POLICY in $POLICIES
  do
    aws iam detach-role-policy \
      --role-name "$ROLE" \
      --policy-arn "$POLICY"
  done

  aws iam delete-role \
    --role-name "$ROLE" 2>/dev/null
done


# ============================================================
# 13. DELETE CUSTOM IAM POLICIES
# ============================================================

echo ""
echo "STEP 13: Checking IAM policies..."

POLICY_ARNS=$(aws iam list-policies \
  --scope Local \
  --query "Policies[?PolicyName=='ThanosS3Policy' || PolicyName=='AWSLoadBalancerControllerIAMPolicy'].Arn" \
  --output text)

for POLICY_ARN in $POLICY_ARNS
do

  echo "Deleting IAM policy: $POLICY_ARN"

  VERSIONS=$(aws iam list-policy-versions \
    --policy-arn "$POLICY_ARN" \
    --query "Versions[?IsDefaultVersion==\`false\`].VersionId" \
    --output text)

  for VERSION in $VERSIONS
  do
    aws iam delete-policy-version \
      --policy-arn "$POLICY_ARN" \
      --version-id "$VERSION"
  done

  aws iam delete-policy \
    --policy-arn "$POLICY_ARN" \
    2>/dev/null

done


# ============================================================
# 14. FINAL CHECK
# ============================================================

echo ""
echo "============================================================"
echo " FINAL AWS RESOURCE CHECK"
echo "============================================================"

echo ""
echo "EKS Clusters:"
aws eks list-clusters \
  --region $AWS_REGION

echo ""
echo "NAT Gateways:"
aws ec2 describe-nat-gateways \
  --region $AWS_REGION \
  --query "NatGateways[?State!='deleted'].[NatGatewayId,State,VpcId]" \
  --output table

echo ""
echo "Elastic IPs:"
aws ec2 describe-addresses \
  --region $AWS_REGION \
  --output table

echo ""
echo "Load Balancers:"
aws elbv2 describe-load-balancers \
  --region $AWS_REGION \
  --output table

echo ""
echo "CloudFormation eksctl stacks:"
aws cloudformation list-stacks \
  --region $AWS_REGION \
  --query "StackSummaries[?contains(StackName,'eksctl') && StackStatus!='DELETE_COMPLETE'].[StackName,StackStatus]" \
  --output table

echo ""
echo "============================================================"
echo " CLEANUP SCRIPT FINISHED"
echo "============================================================"

echo ""
echo "IMPORTANT:"
echo "If VPCs are still present, delete them manually after all"
echo "CloudFormation stacks and NAT Gateways are completely deleted."
