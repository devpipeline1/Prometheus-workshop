Create the application
======================
sudo mkdir -p /opt/sample-app
sudo chown -R ec2-user:ec2-user /opt/sample-app

cd /opt/sample-app
vi app.py

import logging
import os

from flask import Flask, jsonify

LOG_DIR = "/var/log/sample-app"
LOG_FILE = os.path.join(LOG_DIR, "app.log")

os.makedirs(LOG_DIR, exist_ok=True)

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(name)s %(message)s",
    handlers=[
        logging.FileHandler(LOG_FILE),
        logging.StreamHandler()
    ]
)

logger = logging.getLogger("sample-app")

app = Flask(__name__)


@app.route("/")
def home():
    logger.info("Home endpoint called")

    return jsonify({
        "message": "Hello from sample Flask application"
    })


@app.route("/hello")
def hello():
    logger.info("Hello endpoint called")

    return jsonify({
        "message": "Hello World"
    })


@app.route("/error")
def error():

    logger.error("This is a test error")

    try:
        raise ValueError("This is a simulated application error")

    except Exception:
        logger.exception("Simulated application failure")

        return jsonify({
            "error": "This is a simulated application error"
        }), 500


if __name__ == "__main__":

    logger.info("Starting sample Flask application")

    app.run(
        host="0.0.0.0",
        port=8080
    )



