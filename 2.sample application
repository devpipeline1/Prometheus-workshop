**Start the application**
=========================
cd /opt/sample-app

python3 app.py

curl http://localhost:8080/
{
  "message": "Hello from sample Flask application",
  "service": "sample-flask-app"
}




                        (OR)

sudo vi /etc/systemd/system/sample-app.service
=============================================
[Unit]
Description=Sample Flask Application
After=network.target

[Service]
Type=simple

User=ec2-user
Group=ec2-user

WorkingDirectory=/opt/sample-app

ExecStart=/usr/bin/python3 /opt/sample-app/app.py

Restart=always
RestartSec=5

Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target


sudo systemctl daemon-reload
sudo systemctl enable sample-app
sudo systemctl start sample-app


