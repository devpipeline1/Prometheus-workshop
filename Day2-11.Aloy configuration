Add Tempo datasource to Grafana:
Update your existing grafana-values.yaml.

datasources:
  datasources.yaml:
    apiVersion: 1
    datasources:

      # ============================================================
      # METRICS - Thanos
      # ============================================================

      - name: Thanos
        type: prometheus
        access: proxy
        url: http://thanos-query.monitoring.svc.cluster.local:9090
        isDefault: true
        editable: true

      # ============================================================
      # LOGS - Loki
      # ============================================================

      - name: Loki
        type: loki
        access: proxy
        url: http://loki.monitoring.svc.cluster.local:3100
        editable: true

      # ============================================================
      # TRACES - Tempo
      # ============================================================

      - name: Tempo
        type: tempo
        access: proxy
        url: http://tempo.monitoring.svc.cluster.local:3200
        editable: true



helm upgrade grafana grafana/grafana \
  -n monitoring \
  -f grafana-values.yaml


