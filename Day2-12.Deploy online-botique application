Inject Python Services

Annotate emailservice:
increase memory for email service

kubectl patch deployment emailservice \
  -n online-boutique \
  --type='strategic' \
  -p '{
    "spec": {
      "template": {
        "spec": {
          "containers": [
            {
              "name": "server",
              "resources": {
                "requests": {
                  "cpu": "100m",
                  "memory": "128Mi"
                },
                "limits": {
                  "cpu": "500m",
                  "memory": "512Mi"
                }
              }
            }
          ]
        }
      }
    }
  }'


kubectl patch deployment emailservice \
  -n online-boutique \
  --type='merge' \
  -p '{
    "spec": {
      "template": {
        "metadata": {
          "annotations": {
            "instrumentation.opentelemetry.io/inject-python": "online-boutique-instrumentation"
          }
        }
      }
    }
  }'

