vi alloy-values.yaml
alloy:
  configMap:
    create: true
    content: |
      logging {
        level  = "info"
        format = "logfmt"
      }

      // ============================================================
      // PROMETHEUS REMOTE WRITE
      // ============================================================

      prometheus.remote_write "monitoring" {
        endpoint {
          url = "http://k8s-monitori-promethe-e0617ba28f-d5c130e99c27d8ba.elb.ap-south-1.amazonaws.com:9090/api/v1/write"
        }
      }


      // ============================================================
      // KUBERNETES POD DISCOVERY
      // ============================================================

      discovery.kubernetes "pods" {
        role = "pod"
      }


      // ============================================================
      // DISCOVER PODS WITH prometheus.io/scrape=true
      // ============================================================

      discovery.relabel "metrics_pods" {
        targets = discovery.kubernetes.pods.targets

        rule {
          source_labels = [
            "__meta_kubernetes_pod_annotation_prometheus_io_scrape",
          ]

          action = "keep"
          regex  = "true"
        }

        rule {
          source_labels = [
            "__meta_kubernetes_pod_annotation_prometheus_io_scheme",
          ]

          action       = "replace"
          target_label = "__scheme__"
          regex        = "(https?)"
        }

        rule {
          source_labels = [
            "__meta_kubernetes_pod_annotation_prometheus_io_path",
          ]

          action       = "replace"
          target_label = "__metrics_path__"
          regex        = "(.+)"
        }

        rule {
          source_labels = [
            "__address__",
            "__meta_kubernetes_pod_annotation_prometheus_io_port",
          ]

          action       = "replace"
          target_label = "__address__"
          regex        = "(.+):(?:\\d+);(\\d+)"
          replacement  = "$1:$2"
        }

        rule {
          source_labels = [
            "__meta_kubernetes_namespace",
          ]

          action       = "replace"
          target_label = "namespace"
        }

        rule {
          source_labels = [
            "__meta_kubernetes_pod_name",
          ]

          action       = "replace"
          target_label = "pod"
        }

        rule {
          source_labels = [
            "__meta_kubernetes_pod_node_name",
          ]

          action       = "replace"
          target_label = "node"
        }

        rule {
          source_labels = [
            "__meta_kubernetes_pod_label_app",
          ]

          action       = "replace"
          target_label = "app"
        }

        // IMPORTANT
        // APPLICATION CLUSTER LABEL

        rule {
          action       = "replace"
          target_label = "cluster"
          replacement  = "application-eks"
        }

        rule {
          action       = "replace"
          target_label = "environment"
          replacement  = "demo"
        }
      }


      // ============================================================
      // SCRAPE APPLICATION POD METRICS
      // ============================================================

      prometheus.scrape "pods" {
        targets = discovery.relabel.metrics_pods.output

        forward_to = [
          prometheus.remote_write.monitoring.receiver,
        ]

        scrape_interval = "30s"
      }

      // ============================================================
      // EXPLICIT KUBE-STATE-METRICS TARGET
      // ============================================================

      prometheus.scrape "kube_state_metrics" {
        targets = [
          {
            "__address__" = "kube-state-metrics.kube-system.svc.cluster.local:8080",
            "cluster"     = "application-eks",
            "environment" = "demo",
            "job"         = "kube-state-metrics",
          },
        ]

        forward_to = [
          prometheus.remote_write.monitoring.receiver,
        ]

        scrape_interval = "30s"
      }



      // ============================================================
      // LOGS
      // ============================================================

      loki.source.kubernetes "pods" {

        targets = discovery.kubernetes.pods.targets

        forward_to = [
          loki.write.monitoring.receiver,
        ]
      }


      loki.write "monitoring" {

        endpoint {
          url = "http://k8s-monitori-lokiinge-a09257c812-8872d6d59604b187.elb.ap-south-1.amazonaws.com:3100/loki/api/v1/push"
        }

        external_labels = {
          cluster     = "application-eks",
          environment = "demo",
        }
      }


      // ============================================================
      // OTLP RECEIVER
      // ============================================================

      otelcol.receiver.otlp "application" {

        grpc {
          endpoint = "0.0.0.0:4317"
        }

