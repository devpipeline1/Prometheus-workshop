Create the Instrumentation Resource:
==================================

vi instrumentation.yaml

apiVersion: opentelemetry.io/v1alpha1
kind: Instrumentation
metadata:
  name: online-boutique-instrumentation
  namespace: online-boutique

spec:

  exporter:
    endpoint: http://alloy-otlp.alloy.svc.cluster.local:4317

  propagators:
    - tracecontext
    - baggage
    - b3

  sampler:
    type: parentbased_traceidratio
    argument: "1"

  python:
    env:
      - name: OTEL_EXPORTER_OTLP_ENDPOINT
        value: http://alloy-otlp.alloy.svc.cluster.local:4318

  nodejs:
    env:
      - name: OTEL_EXPORTER_OTLP_ENDPOINT
        value: http://alloy-otlp.alloy.svc.cluster.local:4318

  java:
    env:
      - name: OTEL_EXPORTER_OTLP_ENDPOINT
        value: http://alloy-otlp.alloy.svc.cluster.local:4318

  dotnet:
    env:
      - name: OTEL_EXPORTER_OTLP_ENDPOINT
        value: http://alloy-otlp.alloy.svc.cluster.local:4318


