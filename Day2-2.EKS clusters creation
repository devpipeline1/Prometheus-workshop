Create Monitoring EKS
====================
source network-output.env

echo $MON_VPC_ID
echo $MON_PRIVATE_1_ID
echo $MON_PRIVATE_2_ID
echo $MON_CLUSTER_NAME

vi monitoring-eks.yaml

apiVersion: eksctl.io/v1alpha5
kind: ClusterConfig

metadata:
  name: monitoring-eks
  region: ap-south-1
  version: "1.36"

iam:
  withOIDC: true

vpc:
  id: $MON_VPC_ID

  subnets:
    private:
      monitoring-private-a:
        id: $MON_PRIVATE_1_ID

      monitoring-private-b:
        id: $MON_PRIVATE_2_ID

managedNodeGroups:
  - name: monitoring-workers
    instanceType: t3.xlarge
    minSize: 2
    desiredCapacity: 2
    maxSize: 3

    privateNetworking: true
    volumeSize: 50
    volumeType: gp3
    labels:
      workload: monitoring

    tags:
      Name: monitoring-eks-worker
      Environment: demo
      Cluster: monitoring-eks
      Workload: monitoring

addons:
  - name: vpc-cni
  - name: coredns
  - name: kube-proxy
  - name: aws-ebs-csi-driver
  - name: metrics-server

Replace VPC id and subnetid's

eksctl create cluster \
  -f monitoring-eks.yaml

Connect kubectl to Monitoring EKS
=================================
aws eks update-kubeconfig \
  --region ap-south-1 \
  --name monitoring-eks

kubectl get nodes -o wide

10.20.11.x
10.20.12.x

Rename contest so it will be easy to switch clusters
kubectl config rename-context \
  $(kubectl config get-contexts -o name | grep 'cluster/application-eks') \
  application-eks

kubectl config rename-context \
  $(kubectl config get-contexts -o name | grep 'cluster/monitoring-eks') \
  monitoring-eks

kubectl config get-contexts 
kubectl config use-context application-eks
kubectl config use-context monitoring-eks

Verify Monitoring EKS add-ons
aws eks list-addons \
  --region ap-south-1 \
  --cluster-name monitoring-eks

Verify EBS CSI
kubectl get pods -n kube-system | grep ebs



