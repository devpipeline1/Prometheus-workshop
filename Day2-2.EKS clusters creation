Create Application EKS:
======================
2.1 First load your network variables

2.2 Check your tools
aws --version
eksctl version
kubectl version --client

2.3 Create Application EKS configuration

vi application-eks.yaml

apiVersion: eksctl.io/v1alpha5
kind: ClusterConfig

metadata:
  name: application-eks
  region: ap-south-1
  version: "1.36"

iam:
  withOIDC: true

vpc:
  id: vpc-0fb435c6f4f8727e1

  subnets:
    private:
      app-private-a:
        id: subnet-0355b32c991dcb07b
      app-private-b:
        id: subnet-0a718745b22d757ce

managedNodeGroups:
  - name: application-workers
    instanceType: t3.large
    minSize: 2
    desiredCapacity: 2
    maxSize: 3
    privateNetworking: true
    volumeSize: 50
    volumeType: gp3
    labels:
      workload: application
    tags:
      Name: application-eks-worker
      Environment: demo
      Cluster: application-eks
      Workload: application
addons:
  - name: vpc-cni
  - name: coredns
  - name: kube-proxy
  - name: aws-ebs-csi-driver


The important part is: privateNetworking: true
So our application EC2 worker nodes will be here:

