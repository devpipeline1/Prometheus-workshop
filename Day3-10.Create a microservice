Now we will deploy this image/microservice into our easytrade application:

vi easytrade-demo.yaml

apiVersion: apps/v1
kind: Deployment
metadata:
  name: easytrade-demo-service
  namespace: easytrade
  labels:
    app: easytrade-demo-service

spec:
  replicas: 1

  selector:
    matchLabels:
      app: easytrade-demo-service

  template:
    metadata:
      labels:
        app: easytrade-demo-service

    spec:
      containers:
        - name: easytrade-demo-service

          image: devpipeline/easytrade:demo
          imagePullPolicy: Always

          ports:
            - name: http
              containerPort: 8080

          readinessProbe:
            httpGet:
              path: /health
              port: 8080

          livenessProbe:
            httpGet:
              path: /health
              port: 8080

---
apiVersion: v1
kind: Service
metadata:
  name: easytrade-demo-service
  namespace: easytrade
  labels:
    app: easytrade-demo-service

spec:
  selector:
    app: easytrade-demo-service

  ports:
    - name: http
      port: 8080
      targetPort: http

  type: ClusterIP



