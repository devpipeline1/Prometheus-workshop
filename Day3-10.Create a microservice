vi app.py
from flask import Flask, jsonify
from prometheus_client import Counter, Histogram, Gauge, generate_latest, CONTENT_TYPE_LATEST
import random
import time

app = Flask(__name__)


# ============================================================
# PROMETHEUS METRICS
# ============================================================

REQUEST_COUNT = Counter(
    "easytrade_demo_http_requests_total",
    "Total HTTP requests",
    ["method", "endpoint", "status"]
)

REQUEST_DURATION = Histogram(
    "easytrade_demo_http_request_duration_seconds",
    "HTTP request duration",
    ["endpoint"]
)

ORDERS_TOTAL = Counter(
    "easytrade_demo_orders_total",
    "Total demo orders processed"
)

ACTIVE_USERS = Gauge(
    "easytrade_demo_active_users",
    "Current simulated active users"
)


# ============================================================
# APPLICATION ENDPOINT
# ============================================================

@app.route("/api/demo")
def demo():

    start_time = time.time()

    # Simulate application processing
    processing_time = random.uniform(0.1, 0.8)
    time.sleep(processing_time)

    # Generate demo metrics
    ORDERS_TOTAL.inc()

    active_users = random.randint(5, 50)
    ACTIVE_USERS.set(active_users)

    duration = time.time() - start_time

    REQUEST_COUNT.labels(
        method="GET",
        endpoint="/api/demo",
        status="200"
    ).inc()

    REQUEST_DURATION.labels(
        endpoint="/api/demo"
    ).observe(duration)

    return jsonify({
        "status": "success",
        "message": "EasyTrade Demo Service is working",
        "processing_time_seconds": round(duration, 3),
        "active_users": active_users
    })


# ============================================================
# HEALTH CHECK
# ============================================================

@app.route("/health")
def health():

    return jsonify({
        "status": "healthy"
    })


# ============================================================
# PROMETHEUS METRICS
# ============================================================

@app.route("/metrics")
def metrics():

    return generate_latest(), 200, {
        "Content-Type": CONTENT_TYPE_LATEST
    }

# ============================================================
# START APPLICATION
# ============================================================
if __name__ == "__main__":

    app.run(
        host="0.0.0.0",
        port=8080
    )



