alloy:
  configMap:
    content: |
      // =====================================================
      // LOGGING
      // =====================================================

      logging {
        level  = "info"
        format = "logfmt"
      }


      // =====================================================
      // REMOTE WRITE TO MIMIR
      // =====================================================

      prometheus.remote_write "mimir" {

        endpoint {

          url = "http://a1a59c4d9dc284219ba4fd9ffd58cd12-1296e3666176ea98.elb.ap-south-1.amazonaws.com/api/v1/push"

        }

      }


      // =====================================================
      // DISCOVER KUBERNETES NODES
      // =====================================================

      discovery.kubernetes "nodes" {

        role = "node"

      }


      // =====================================================
      // KUBELET METRICS
      // =====================================================

      discovery.relabel "kubelet" {

        targets = discovery.kubernetes.nodes.targets


        rule {

          source_labels = [
            "__meta_kubernetes_node_address_InternalIP",
          ]

          regex = "(.+)"

          target_label = "__address__"

          replacement = "$1:10250"

        }


        rule {

          target_label = "__metrics_path__"

          replacement = "/metrics"

        }


        rule {

          target_label = "cluster"

          replacement = "application-eks"

        }


        rule {

          source_labels = [
            "__meta_kubernetes_node_name",
          ]

          target_label = "node"

        }

      }


      prometheus.scrape "kubelet" {

        targets = discovery.relabel.kubelet.output


        forward_to = [
          prometheus.remote_write.mimir.receiver,
        ]


        scheme = "https"


        scrape_interval = "30s"


        scrape_timeout = "10s"


        tls_config {

          insecure_skip_verify = true

        }


        bearer_token_file =
          "/var/run/secrets/kubernetes.io/serviceaccount/token"

      }


      // =====================================================
      // CADVISOR METRICS
      // =====================================================

      discovery.relabel "cadvisor" {

        targets = discovery.kubernetes.nodes.targets


        rule {

          source_labels = [
            "__meta_kubernetes_node_address_InternalIP",
          ]

          regex = "(.+)"

          target_label = "__address__"

          replacement = "$1:10250"

        }


        rule {

          target_label = "__metrics_path__"

          replacement = "/metrics/cadvisor"

        }


        rule {

          target_label = "cluster"

          replacement = "application-eks"

        }


        rule {

          source_labels = [
            "__meta_kubernetes_node_name",
          ]

          target_label = "node"

        }

      }


      prometheus.scrape "cadvisor" {

        targets = discovery.relabel.cadvisor.output


        forward_to = [
          prometheus.remote_write.mimir.receiver,
        ]


        scheme = "https"


        scrape_interval = "30s"


        scrape_timeout = "10s"


        tls_config {

          insecure_skip_verify = true

        }


        bearer_token_file =
          "/var/run/secrets/kubernetes.io/serviceaccount/token"

      }


      // =====================================================
      // KUBE-STATE-METRICS
      // =====================================================

      prometheus.scrape "kube_state_metrics" {

        targets = [
          {
            "__address__" = "kube-state-metrics.kube-state-metrics.svc.cluster.local:8080",
            "cluster"     = "application-eks",
            "job"         = "kube-state-metrics",
          },
        ]


        forward_to = [
          prometheus.remote_write.mimir.receiver,
        ]


        scrape_interval = "30s"


        scrape_timeout = "10s"

      }


      // =====================================================
      // EASYTRADE APPLICATION POD DISCOVERY
      // =====================================================

      discovery.kubernetes "easytrade_pods" {

        role = "pod"

        namespaces {
          names = ["easytrade"]
        }

      }


      // =====================================================
      // FILTER ONLY EASYTRADE DEMO SERVICE
      // =====================================================

      discovery.relabel "easytrade_demo_service" {

        targets = discovery.kubernetes.easytrade_pods.targets


        // ---------------------------------------------------
        // Keep only easytrade-demo-service pods
        // ---------------------------------------------------

        rule {

          source_labels = [
            "__meta_kubernetes_pod_label_app",
          ]

          regex = "easytrade-demo-service"

          action = "keep"

        }


        // ---------------------------------------------------
        // Keep only container port 8080
        // ---------------------------------------------------

        rule {

          source_labels = [
            "__meta_kubernetes_pod_container_port_number",
          ]

          regex = "8080"

          action = "keep"

        }


        // ---------------------------------------------------
        // Set target address
        // PodIP:8080
        // ---------------------------------------------------

        rule {

          source_labels = [
            "__meta_kubernetes_pod_ip",
            "__meta_kubernetes_pod_container_port_number",
          ]

          separator = ":"

          regex = "(.+):(.+)"

          target_label = "__address__"

          replacement = "$1:$2"

        }


        // ---------------------------------------------------
        // Cluster label
        // ---------------------------------------------------

        rule {

          target_label = "cluster"

          replacement = "application-eks"

        }


        // ---------------------------------------------------
        // Namespace label
        // ---------------------------------------------------

        rule {

          source_labels = [
            "__meta_kubernetes_namespace",
          ]

          target_label = "namespace"

        }


        // ---------------------------------------------------
        // Pod label
        // ---------------------------------------------------

        rule {

          source_labels = [
            "__meta_kubernetes_pod_name",
          ]

          target_label = "pod"

        }


        // ---------------------------------------------------
        // Service label
        // ---------------------------------------------------

        rule {

          target_label = "service"

          replacement = "easytrade-demo-service"

        }


        // ---------------------------------------------------
        // Job label
        // ---------------------------------------------------

        rule {

          target_label = "job"

          replacement = "easytrade-demo-service"

        }

      }


      // =====================================================
      // SCRAPE EASYTRADE APPLICATION METRICS
      // =====================================================

      prometheus.scrape "easytrade_demo_service" {

        targets =
          discovery.relabel.easytrade_demo_service.output


        forward_to = [
          prometheus.remote_write.mimir.receiver,
        ]


        scrape_interval = "15s"


        scrape_timeout = "10s"


        metrics_path = "/metrics"

      }


